# ───────────────────────────────────────────────────────────────
# Production .env template for Virtualmin VPS deploy.
# Copy to `.env` on the server and fill in real values.
# ───────────────────────────────────────────────────────────────

APP_NAME="Lumiskin Pro"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.lumiskinpro.rs

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Allowed frontend origin(s) for CORS (comma-separated, no trailing slash).
FRONTEND_URL=https://lumiskinpro.rs

LOG_CHANNEL=stack
LOG_LEVEL=error

# PostgreSQL — create this DB + user in Virtualmin (Edit Databases).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lumiskin
DB_USERNAME=lumiskin
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

# Sanctum: the domains that may use the API. Token (Bearer) auth does not
# strictly need this, but keep it aligned with your frontend domain.
SANCTUM_STATEFUL_DOMAINS=lumiskinpro.rs

MAIL_MAILER=log
